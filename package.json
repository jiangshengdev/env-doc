{
  "name": "env-doc",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "favicons": "node scripts/favicons.mjs",
    "format": "prettier --write docs src scripts docusaurus.config.ts sidebars.ts",
    "format:check": "prettier --check src scripts docusaurus.config.ts sidebars.ts tsconfig.json",
    "check": "npm run typecheck && npm run format:check && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@docusaurus/plugin-pwa": "3.10.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2",
    "favicons": "7.3.1",
    "prettier": "3.9.10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.1.2"
    },
    "serialize-javascript": "7.1.4"
  }
}
